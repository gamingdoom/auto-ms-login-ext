{
	"manifest_version": 3,
	"name": "Auto Microsoft Login",
	"version": "1.1",

	"description": "Autofills Microsoft 2FA code on login pages and logs in automatically.",

	"browser_specific_settings": {
		"gecko": {
			"id": "auto-ms-login@sanghai.org",
			"data_collection_permissions": {
				"required": ["none"]
			}
		}
	},

	"content_scripts": [
		{
			"matches": ["*://login.microsoftonline.com/*"],
			"js": [
				"./lib/totp.js",
				"./src/autofill.js"
			],
			"run_at": "document_start"
		}
	],

	"permissions": ["storage"],

	"action": {
		"default_title": "Auto Microsoft Login",
		"default_popup": "./menu/menu.html"
	}
}